{
  "$comment": "Secret shapes, single source of truth. Read by env-core (warning when a user pastes a value into descriptive metadata) and by scripts/check-public-boundary.mjs (commit-time scan). A rule is a list of segments matched in order: a literal, or a run of characters from one declared charset between min and max. This is intentionally not a regex: the Rust side needs no regex engine and a data file cannot carry a backtracking pattern. Adding a rule changes a user-facing warning, so keep it high-confidence and keep runs short.",
  "schemaVersion": 3,
  "charsets": {
    "lower": "abcdefghijklmnopqrstuvwxyz",
    "upper": "ABCDEFGHIJKLMNOPQRSTUVWXYZ",
    "digit": "0123456789",
    "alnum": "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789",
    "upperDigit": "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789",
    "upperSpaceDigit": "ABCDEFGHIJKLMNOPQRSTUVWXYZ ",
    "alnumDash": "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-",
    "alnumUnder": "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_",
    "alnumDashUnder": "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-_",
    "ghTypes": "pousr",
    "slackTypes": "baprs",
    "stripePrefix": "skrk"
  },
  "rules": [
    {
      "id": "private-key-pem",
      "segments": [
        {
          "literal": "-----BEGIN"
        },
        {
          "run": "upperSpaceDigit",
          "min": 1,
          "max": 48
        },
        {
          "literal": "PRIVATE KEY-----"
        }
      ]
    },
    {
      "id": "age-secret-key",
      "segments": [
        {
          "literal": "AGE-SECRET-KEY-1"
        },
        {
          "run": "upperDigit",
          "min": 20,
          "max": 260
        }
      ]
    },
    {
      "id": "github-token",
      "segments": [
        {
          "literal": "gh"
        },
        {
          "run": "ghTypes",
          "min": 1,
          "max": 1
        },
        {
          "literal": "_"
        },
        {
          "run": "alnumUnder",
          "min": 30,
          "max": 270
        }
      ]
    },
    {
      "id": "aws-access-key",
      "segments": [
        {
          "literal": "AKIA"
        },
        {
          "run": "upperDigit",
          "min": 16,
          "max": 256
        }
      ]
    },
    {
      "id": "google-api-key",
      "segments": [
        {
          "literal": "AIza"
        },
        {
          "run": "alnumDashUnder",
          "min": 30,
          "max": 270
        }
      ]
    },
    {
      "id": "anthropic-api-key",
      "segments": [
        {
          "literal": "sk-ant-"
        },
        {
          "run": "alnumDashUnder",
          "min": 20,
          "max": 260
        }
      ]
    },
    {
      "id": "openai-api-key",
      "segments": [
        {
          "literal": "sk-"
        },
        {
          "run": "alnumDashUnder",
          "min": 20,
          "max": 260
        }
      ]
    },
    {
      "id": "slack-token",
      "segments": [
        {
          "literal": "xox"
        },
        {
          "run": "slackTypes",
          "min": 1,
          "max": 1
        },
        {
          "literal": "-"
        },
        {
          "run": "alnumDash",
          "min": 20,
          "max": 260
        }
      ]
    },
    {
      "id": "stripe-secret-key",
      "segments": [
        {
          "run": "stripePrefix",
          "min": 2,
          "max": 2
        },
        {
          "literal": "_"
        },
        {
          "run": "lower",
          "min": 4,
          "max": 4
        },
        {
          "literal": "_"
        },
        {
          "run": "alnum",
          "min": 20,
          "max": 260
        }
      ]
    },
    {
      "id": "npm-token",
      "segments": [
        {
          "literal": "npm_"
        },
        {
          "run": "alnum",
          "min": 30,
          "max": 270
        }
      ]
    },
    {
      "id": "gitlab-token",
      "segments": [
        {
          "literal": "glpat-"
        },
        {
          "run": "alnumDashUnder",
          "min": 20,
          "max": 260
        }
      ]
    }
  ]
}
